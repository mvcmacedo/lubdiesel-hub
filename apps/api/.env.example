# Application
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://lubdiesel:lubdiesel@localhost:5432/lubdiesel?schema=public

# Auth
JWT_SECRET=change-me-access-secret-min-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# CORS / Frontend
FRONTEND_URL=http://localhost:3000

# Logging (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# Rate limiting (auth endpoints)
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Optional (reserved for future use)
REDIS_URL=

# Seed
SEED_ADMIN_EMAIL=admin@lubdiesel.com.br
SEED_ADMIN_PASSWORD=ChangeMe123!
